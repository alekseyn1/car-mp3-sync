# /etc/carmp3.conf - site settings for carmp3-sync.
# Every value here has a default in the script; set only what differs.

# NAS holding the library.
# NAS_HOST_LAN is tried first. NAS_HOST_VPN is the Tailscale address, used when
# the car is away from home - and it is the ONLY route for a unit that never
# sees the home LAN. Leave NAS_HOST_VPN empty to disable the fallback.
NAS_HOST_LAN=192.168.10.5
NAS_HOST_VPN=

# Order the routes are tried in. Use "vpn lan" for a unit that never sees the
# home LAN, so it does not waste ~20s per start on retries that cannot succeed.
# NOTE the quotes: this file is sourced by the shell, and an unquoted value
# with a space in it sets the variable only for a command named by the second
# word, which silently leaves it unset.
NAS_ROUTE_ORDER="lan vpn"

NAS_SHARE=Storage
NAS_SUBPATH=Music/Youtube/Output

# SMB credentials file, mode 600 root:root, containing:
#   username=carmp3
#   password=...
# Use a dedicated read-only account, not a personal one. This device lives in
# a car and can be stolen.
CRED=/etc/carmp3-nas.cred

# Mount options for the FAT32 image. utf8=1 is not optional if any filename is
# non-ASCII: the default iocharset=ascii makes them fail with EINVAL.
VFAT_OPTS=uid=1000,gid=1000,utf8=1,codepage=866

# FAT32 volume serial, shared by both ping-pong images so the head unit sees one
# stick instead of a new one every boot. Some units re-run first-time setup, or
# ask to store voice-recognition data, for each unfamiliar volume.
# Leave empty to keep whatever mkfs.vfat generated.
VOLUME_ID="CA4D-0301"
