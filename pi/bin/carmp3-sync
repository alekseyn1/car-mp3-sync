#!/bin/bash
# Sync the library from the NAS into the image the car is NOT playing from,
# then flip the pointer so the next boot serves it. The car never sees a
# volume being written to.
set -uo pipefail

# Site settings. Everything here can be overridden in /etc/carmp3.conf so the
# script itself stays generic; see carmp3.conf.example.
[ -r /etc/carmp3.conf ] && . /etc/carmp3.conf

# Two routes to the NAS. The LAN address is tried first because it is fast and
# costs nothing. NAS_HOST_VPN is the tailnet address, used when the car is not
# at home - and for a unit that never sees the home LAN at all (a car in another
# country) it is the only route.
NAS_HOST_LAN="${NAS_HOST_LAN:-${NAS_HOST:-192.168.10.5}}"
NAS_HOST_VPN="${NAS_HOST_VPN:-}"
# Which route to try first. A unit that lives on the home LAN wants "lan vpn";
# one that never sees it - a car in another country - wants "vpn lan", so it
# does not burn ~20s on LAN retries that can never succeed.
NAS_ROUTE_ORDER="${NAS_ROUTE_ORDER:-lan vpn}"
# Pin both images to one FAT32 volume serial so the head unit treats them as a
# single stick rather than a new one every boot - some units re-run their
# first-time setup, or re-prompt to store voice data, on each unfamiliar volume.
# Set empty to leave whatever mkfs.vfat generated.
VOLUME_ID="${VOLUME_ID:-CA4D-0301}"
NAS_SHARE="${NAS_SHARE:-Storage}"
NAS_SUBPATH="${NAS_SUBPATH:-Music/Youtube/Output}"
CRED="${CRED:-/etc/carmp3-nas.cred}"

STATE=/data/state
IMAGES=/data/images
LOG=/data/log/carmp3-sync.log
NASMNT=/mnt/nas
SYNCMNT=/mnt/sync
SRC="$NASMNT/$NAS_SUBPATH"
# codepage 866 + utf8=1 is what makes Cyrillic filenames writable on FAT32
VFAT_OPTS="${VFAT_OPTS:-uid=1000,gid=1000,utf8=1,codepage=866}"
BEEP=/usr/local/sbin/carmp3-beep
LOOP=""

mkdir -p "$(dirname "$LOG")" "$STATE" "$NASMNT" "$SYNCMNT"
# keep the log from growing without bound on a read-only-root appliance
[ -f "$LOG" ] && [ "$(stat -c%s "$LOG")" -gt 1048576 ] && tail -c 262144 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
log() { echo "$(date '+%F %T') $*" | tee -a "$LOG"; }
beep() { [ -x "$BEEP" ] && "$BEEP" "$1" 2>/dev/null; }

exec 9>/run/carmp3-sync.lock
flock -n 9 || { log "another sync is already running, skipping"; exit 0; }

cleanup() {
  mountpoint -q "$SYNCMNT" && umount "$SYNCMNT"
  [ -n "$LOOP" ] && losetup -d "$LOOP" 2>/dev/null
  mountpoint -q "$NASMNT" && umount "$NASMNT"
}
trap cleanup EXIT

# What the car is being served is whatever the gadget has bound, which is not
# the same thing as the pointer: the pointer is flipped at the end of every run.
# Deriving the target from the pointer means a second sync in the same boot
# picks the live image and writes into the volume the car is reading - exactly
# what the A/B split exists to prevent. Ask the gadget instead, and fall back to
# the pointer only when it is not up yet (which is the case early in boot).
LUN=/sys/kernel/config/usb_gadget/carmp3/functions/mass_storage.0/lun.0/file
BOUND=$(cat "$LUN" 2>/dev/null)
BOUND=${BOUND##*/}; BOUND=${BOUND%.img}
case "$BOUND" in
  A|B) ACTIVE=$BOUND ;;
  *)   ACTIVE=$(cat "$STATE/active" 2>/dev/null) ;;
esac
case "$ACTIVE" in A) TARGET=B ;; B) TARGET=A ;; *) ACTIVE=A; TARGET=B ;; esac
IMG="$IMAGES/$TARGET.img"
log "=== sync start: car is playing $ACTIVE, writing into $TARGET ==="

[ -f "$IMG" ] || { log "target image missing: $IMG"; beep failed; exit 1; }

# Pick a route. Tailscale is not up yet at the point in boot where this runs,
# so give it a little time before concluding we are offline.
try_lan() {
  [ -n "$NAS_HOST_LAN" ] || return 1
  i=0
  while [ $i -lt 5 ]; do
    if ping -c1 -W2 "$NAS_HOST_LAN" >/dev/null 2>&1; then
      ROUTE=lan; NAS_HOST="$NAS_HOST_LAN"; return 0
    fi
    sleep 2; i=$((i+1))
  done
  return 1
}

try_vpn() {
  [ -n "$NAS_HOST_VPN" ] || return 1
  command -v tailscale >/dev/null 2>&1 || return 1
  i=0
  while [ $i -lt 30 ]; do
    if tailscale status >/dev/null 2>&1 && ping -c1 -W3 "$NAS_HOST_VPN" >/dev/null 2>&1; then
      ROUTE=vpn; NAS_HOST="$NAS_HOST_VPN"
      [ $i -gt 0 ] && log "waited $((i*2))s for the tailnet"
      return 0
    fi
    sleep 2; i=$((i+1))
  done
  return 1
}

pick_nas() {
  # Wait for the interface to actually carry a route. This runs early enough in
  # boot that WiFi is often still associating, and judging the network from a
  # single failed ping here sends a car sitting at home out over the tailnet.
  i=0
  while [ $i -lt 20 ] && ! ip -4 route show default 2>/dev/null | grep -q .; do
    sleep 1; i=$((i+1))
  done
  for r in $NAS_ROUTE_ORDER; do
    case "$r" in
      lan) try_lan && return 0 ;;
      vpn) try_vpn && return 0 ;;
    esac
  done
  return 1
}

ROUTE=""; NAS_HOST=""
if ! pick_nas; then
  log "NAS unreachable (tried: $NAS_ROUTE_ORDER; lan=$NAS_HOST_LAN vpn=${NAS_HOST_VPN:-unset}) - nothing to do"
  beep nowifi
  exit 0
fi
log "reaching the NAS over $ROUTE at $NAS_HOST"

if ! mount -t cifs "//$NAS_HOST/$NAS_SHARE" "$NASMNT" \
      -o "credentials=$CRED,ro,vers=3.0,uid=1000,gid=1000,iocharset=utf8"; then
  log "NAS mount failed"; beep failed; exit 1
fi
[ -d "$SRC" ] || { log "source dir missing: $SRC"; beep failed; exit 1; }

LOOP=$(losetup -fP --show "$IMG") || { log "losetup failed"; beep failed; exit 1; }
# Repair the target before writing to it. A run that dies mid-write - a full
# disk, a power cut - leaves the image dirty, and vfat then remounts read-only
# the moment rsync touches it, so every subsequent sync fails identically until
# someone intervenes. The post-sync fsck below guards what the car receives;
# this one guards what we are about to write into.
if command -v fsck.vfat >/dev/null; then
  FSCKOUT=$(fsck.vfat -a "${LOOP}p1" 2>&1)
  case "$FSCKOUT" in
    *"Dirty bit"*|*"Auto-correcting"*|*"Reclaimed"*|*"Truncating"*)
      log "repaired $TARGET before writing: $(printf '%s' "$FSCKOUT" | grep -cE 'Auto-correcting|Truncating|Reclaimed|Dirty') issue(s)" ;;
  esac
fi

if [ -n "$VOLUME_ID" ] && [ -x /usr/local/sbin/carmp3-volid ]; then
  VOUT=$(/usr/local/sbin/carmp3-volid "${LOOP}p1" "$VOLUME_ID" 2>&1)
  case "$VOUT" in *'->'*) log "volume id $TARGET: $VOUT" ;; esac
fi

mount -o "$VFAT_OPTS,discard" "${LOOP}p1" "$SYNCMNT" || { log "image mount failed"; beep failed; exit 1; }

# fsck.vfat salvages orphaned cluster chains into FSCK####.REC files at the
# image root. They are repair debris, never content - but rsync sees files the
# source does not have and tries to delete them, which trips --max-delete and
# fails the whole sync. Clear them here so the delete guard stays meaningful
# for actual music.
RECS=$(find "$SYNCMNT" -maxdepth 1 -iname 'FSCK*.REC' 2>/dev/null | wc -l)
if [ "$RECS" -gt 0 ]; then
  find "$SYNCMNT" -maxdepth 1 -iname 'FSCK*.REC' -delete 2>/dev/null
  log "removed $RECS fsck recovery file(s) from $TARGET"
fi

# --max-delete is the second line of defence behind youtube.py's own gate:
# a bad run on the NAS must never be able to empty the car.
OUT=$(rsync -rt --modify-window=2 --delete-after --max-delete=20 \
        --itemize-changes "$SRC/" "$SYNCMNT/" 2>&1)
RC=$?
CHANGES=$(printf '%s\n' "$OUT" | grep -cE '^[<>ch*]')
log "rsync rc=$RC changes=$CHANGES"
[ "$CHANGES" -gt 0 ] && printf '%s\n' "$OUT" | grep -E '^[<>ch*]' | head -40 >> "$LOG"

if [ $RC -ne 0 ]; then
  log "rsync failed (rc=$RC) - NOT flipping, car keeps playing $ACTIVE"
  printf '%s\n' "$OUT" | tail -5 >> "$LOG"
  beep failed; exit 1
fi

FILES=$(find "$SYNCMNT" -type f | wc -l)
log "image $TARGET now holds $FILES files"
ls -la "$SYNCMNT" | tail -n +2 >> "$LOG"

# The images are sparse. rsync replacing a file frees the old clusters inside
# FAT32, but ext4 keeps those blocks allocated in the backing file, so each
# image creeps toward its full apparent size no matter how little it holds -
# 2.8 GB of music was occupying 7.5 GB after enough sync cycles, and eventually
# filled /data and forced the image read-only mid-write. Punch the freed
# clusters back out.
if command -v fstrim >/dev/null; then
  TRIMMED=$(fstrim -v "$SYNCMNT" 2>/dev/null | sed 's/.*: //')
  [ -n "$TRIMMED" ] && log "fstrim: reclaimed $TRIMMED"
fi

umount "$SYNCMNT"

# Car head units play files in the order the FAT directory entries were
# written, not filename order, and rsync writes in source-walk order which is
# effectively random. Two passes: everything by natural name, then the root
# alone by mtime so the playlist folders keep the date order youtube.py sets
# and "Removed tracks" stays last.
if command -v fatsort >/dev/null; then
  if fatsort -n -D / "${LOOP}p1" >/dev/null 2>&1 && fatsort -t -d / "${LOOP}p1" >/dev/null 2>&1; then
    log "fatsort: directory entries sorted"
  else
    log "fatsort FAILED - image is valid but play order will be wrong"
  fi
else
  log "fatsort not installed - play order will be wrong"
fi

# do not hand the car an image that will not mount
if command -v fsck.vfat >/dev/null && ! fsck.vfat -n "${LOOP}p1" >/dev/null 2>&1; then
  log "image $TARGET failed fsck - NOT flipping"
  beep failed; exit 1
fi
losetup -d "$LOOP"; LOOP=""

echo "$TARGET" > "$STATE/active"
sync
log "flipped: next boot serves $TARGET"

# Marker so a retry trigger knows this boot is already done. /run is tmpfs, so
# it clears on reboot and every engine start gets a fresh attempt.
: > /run/carmp3-sync.ok

if [ "$CHANGES" -gt 0 ]; then beep synced; else beep current; fi
log "=== sync done ==="
