#!/usr/bin/env python3
"""Read or set the FAT32 volume serial number of a partition.

mkfs.vfat generates a fresh serial from the clock, so the two ping-pong images
have different ones and the head unit sees a brand new USB stick on every boot
- re-running its first-time setup each time. Pinning both images to the same
serial makes the car believe it is always the same stick.

  carmp3-volid /dev/loop0p1              print the current serial
  carmp3-volid /dev/loop0p1 CA4D-0301    set it (no-op if already correct)

The serial lives at offset 0x43 of the FAT32 boot sector, little-endian, and is
mirrored in the backup boot sector at sector 6. The filesystem must not be
mounted.
"""
import struct
import sys

OFFSET = 0x43
BACKUP_SECTOR = 6
SECTOR = 512


def read_serial(dev):
    with open(dev, 'rb') as f:
        f.seek(OFFSET)
        return struct.unpack('<I', f.read(4))[0]


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    dev = sys.argv[1]
    if len(sys.argv) == 2:
        print('%08X' % read_serial(dev))
        return 0
    want = int(sys.argv[2].replace('-', '').replace('0x', '').replace('0X', ''), 16)
    current = read_serial(dev)
    if current == want:
        print('unchanged %08X' % current)
        return 0
    packed = struct.pack('<I', want)
    with open(dev, 'r+b') as f:
        for sector in (0, BACKUP_SECTOR):
            f.seek(sector * SECTOR + OFFSET)
            f.write(packed)
        f.flush()
    print('%08X -> %08X' % (current, want))
    return 0


if __name__ == '__main__':
    sys.exit(main())
